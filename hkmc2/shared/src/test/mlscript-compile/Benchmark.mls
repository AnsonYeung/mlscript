import "benchmark"

module Benchmark with...

let prefixPath = "hkmc2Benchmarks/src/test/logs/"

class SuiteWrapper(suite) with
  fun add(nme, fn) =
    suite.add(nme, () => internals.runStackSafe(fn))
  fun run(settings) = suite.run(settings)
  fun map(fn) = suite.map(fn)

fun mkSuite() = SuiteWrapper(new! mut benchmark.Suite())

fun setPrefixPath(path) = set prefixPath = path

fun runSuite(suite) =
  let settings = { async: false }
  suite.run(settings)

fun writeResults(suite, path) =
  let jsonStr = JSON.stringify(suite.map((res, _, _) => res), null, 2)
  fs.writeFileSync(prefixPath + path, jsonStr)

fun writeResultsCsv(suite, path) =
  let str = suite.map((res, _, _) => [res.name, res.stats.mean, res.stats.moe].join(",")).join("\n") + "\n"
  fs.writeFileSync(prefixPath + path, str)
