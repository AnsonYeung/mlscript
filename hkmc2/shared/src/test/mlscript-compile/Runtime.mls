// shadow stack

data class ShadowStackMarker(reason)
data class ShadowFunctionContFrame(next: ShadowFunctionContFrame | null, fn: Function, varsClass: Array) with
  fun resume(value) =
    set resumeValue = value
    fn(varsClass)
  fun getLocals: Array[LocalVarInfo] = []
  fun getNme = ""
  fun getLoc = ""
mut val curContTrace: ContTrace | null = null
fun makeNewContTrace() =
  set curContTrace = new mut ContTrace(null, null, null, null, false)
  set
    curContTrace.last = curContTrace
    curContTrace.lastHandler = curContTrace
set curContTrace = new mut ContTrace(null, null, null, null, false)
set
  curContTrace.last = curContTrace
  curContTrace.lastHandler = curContTrace

fun shadowTopLevelTrampoline(limit, body: () -> Any) =
  ShadowStackImpl.topLevelTrampoline(limit, body)

fun shadowPushFrame(fn: Function, vars: Array) =
  let newFrame = new mut ShadowFunctionContFrame(curContTrace.next, fn, vars)
  if curContTrace.last === curContTrace do
    set curContTrace.last = newFrame
  set curContTrace.next = newFrame
  // validateContTrace(curContTrace, "pushFrame")

fun shadowPopFrame() =
  // if curContTrace.next === null do
  //   throw "INVALID CONT TRACE: next was null when popping " + id
  if curContTrace.next === curContTrace.last do
    set curContTrace.last = curContTrace
  set curContTrace.next = curContTrace.next.next
  // validateContTrace(curContTrace, "popFrame")

fun shadowMkEffect(handler, handlerFun) =
  let res = new mut EffectSig(curContTrace, handler, handlerFun)
  set curEffect = res
  makeNewContTrace()
  throw ShadowStackMarker("mkEffect")

fun shadowEnterHandleBlock(handler, body: () -> Any) =
  ShadowStackImpl.enterHandleBlock(handler, body)

fun shadowRethrow(err) =
  ShadowStackImpl.checkUnhandledErr(err)

module ShadowStackImpl with
  object StackDelayHandler with
    fun delay() = shadowMkEffect of this, k =>
      set stackResume = k
  fun enterHandleBlock(handler, body: () -> Any) =
    let handlerFrame = new mut HandlerContFrame(curContTrace.next, curContTrace.nextHandler, handler)
    set
      curContTrace.nextHandler = handlerFrame
      curContTrace.next = null
    if curContTrace.lastHandler === curContTrace do
      set curContTrace.lastHandler = handlerFrame
    if curContTrace.last === curContTrace do
      set curContTrace.last = handlerFrame
    // validateContTrace(curContTrace, "enterHandleBlock")
    let ret = body()
    popHandler(curContTrace)
    ret
  fun topLevelTrampoline(limit, body: () -> Any) =
    makeNewContTrace()
    if limit !== null then
      set curEffect = null
      set stackLimit = limit in...
      set stackDepth = 1 in...
      set stackHandler = StackDelayHandler in...
      let result = 
        RuntimeJS.try_catch(() => enterHandleBlock(StackDelayHandler, body), (err) =>
          checkUnhandledErr(err)
          handleEffects(curEffect)
        )
      while stackResume !== null do
        let saved = stackResume
        set
          stackResume = null
          stackDepth = 1
          result = RuntimeJS.try_catch(saved, checkUnhandledErr)
        if curEffect !== null do
          set result = handleEffects(curEffect)
      result
    else
      RuntimeJS.try_catch(body, (err) =>
        checkUnhandledErr(err)
        handleEffects(curEffect)
      )
  fun popHandler(tr: ContTrace) =
    if tr.lastHandler === tr.nextHandler do
      set tr.lastHandler = tr
      if tr.last === tr.nextHandler do
        set tr.last = tr
    set
      tr.next = tr.nextHandler.next
      tr.nextHandler = tr.nextHandler.nextHandler
    // validateContTrace(tr, "popHandler")
  fun handleEffects(cur: Any): Any =
    while cur is
      EffectSig then
        let nxt = handleEffect(cur)
        if cur === nxt then
          set curEffect = cur
          throw ShadowStackMarker("handleEffects")
        else
          set cur = nxt
      else
        return cur
  fun checkUnhandledErr(err) =
    if curEffect === null do
      // console.log("unhandled error")
      throw err
  fun concatTraces(bottom: ContTrace, top: ContTrace) =
    // let expected = countFramesInTrace(bottom) + countFramesInTrace(top)
    if bottom.next !== null do
      set top.last.next = bottom.next
    if bottom.last !== bottom do
      set top.last = bottom.last
    if bottom.nextHandler !== null do
      set top.lastHandler.nextHandler = bottom.nextHandler
    if bottom.lastHandler !== bottom do
      set top.lastHandler = bottom.lastHandler
    // if countFramesInTrace(top) !== expected do
    //   throw "Concat is wrong: incorrect number of frames"

  // calling conventions:
  // resume, resumeContTrace: throw exceptions when raising an effect, will link the newly called functions to the existing cont trace if an effect is raised
  // handleEffect: does not throw exceptions, returns either a value or a cont trace
  // handleEffects: throws an exception if there is an unhandled effect

  // return either new effect, final result or the same continuation if there is no handler
  fun handleEffect(cur: EffectSig): Any =
    // console.log("handleEffect enter")
    // console.log(cur.contTrace)
    // validateContTrace(cur.contTrace, "handleEffect start")
    // debugEff(cur)
    // find the handle block corresponding to the current effect
    let prevHandlerFrame = cur.contTrace
    while prevHandlerFrame.nextHandler !== null and prevHandlerFrame.nextHandler.handler !== cur.handler do
      set prevHandlerFrame = prevHandlerFrame.nextHandler

    // no matching handle block
    if prevHandlerFrame.nextHandler === null do
      // console.log("bail out, no handle block")
      return cur
    // console.log("handle block found!")

    // the matching handle block
    let handlerFrame = prevHandlerFrame.nextHandler
    
    // unlink and save frames
    let saved = new mut ContTrace(
      handlerFrame.next,
      cur.contTrace.last,
      handlerFrame.nextHandler,
      cur.contTrace.lastHandler,
      false
    )
    if cur.contTrace.last === handlerFrame do set saved.last = saved
    if cur.contTrace.lastHandler === handlerFrame do set saved.lastHandler = saved
    
    // validateContTrace(saved, "saved cont frame")
    
    set
      cur.contTrace.last = handlerFrame
      cur.contTrace.lastHandler = handlerFrame
      handlerFrame.next = null
      handlerFrame.nextHandler = null
    
    // validateContTrace(cur.contTrace, "frames passed to handler")
    
    // handle the effect
    set curEffect = null
    let tmp = set stackDepth += 2 in RuntimeJS.try_catch(() => (cur.handlerFun as Function)(resume(cur.contTrace)), checkUnhandledErr)
    if curEffect !== null then
      set cur = curEffect
      // validateContTrace(cur.contTrace, "frames after handling and effect raised")
      // relink the saved frames
      concatTraces(saved, cur.contTrace)
      // validateContTrace(cur.contTrace, "relinked")
      cur
    else
      // resume the unlinked handle blocks
      let retVal = RuntimeJS.try_catch(() => resumeContTrace(saved, tmp), checkUnhandledErr)
      if curEffect !== null then curEffect
      else retVal

  fun resume(contTrace: ContTrace)(value: Any): Any =
    if contTrace.resumed do
      throw Error("Multiple resumption")
    set contTrace.resumed = true
    resumeContTrace(contTrace, value)

  fun resumeContTrace(contTrace: ContTrace, value: Any): Any =
    // Append these onto the resume frames later
    let savedResumeFrames = curContTrace
    set curContTrace = contTrace
    
    while
      contTrace.next is ShadowFunctionContFrame then
        let curFrame = contTrace.next
        set curEffect = null
        set value = set stackDepth += 3 in
          RuntimeJS.try_catch(() => curFrame.resume(value), err => checkUnhandledErr)
        if curEffect !== null do
          set value = curEffect
        if value is EffectSig then
          // add savedResumeFrames to the *bottom* of the current cont trace
          set contTrace = curEffect.contTrace
          set
            contTrace.resumed = false
            contTrace.last.next = savedResumeFrames.next
            contTrace.lastHandler.nextHandler = savedResumeFrames.nextHandler
          concatTraces(savedResumeFrames, contTrace)
          // validateContTrace(curEffect.contTrace, "resumeContTrace")
          throw ShadowStackMarker("resume")
        else () // The frame is popped by the function upon returning
      contTrace.nextHandler is HandlerContFrame then
        popHandler(contTrace)
      else
        set curContTrace = savedResumeFrames
        return value


// CPS

data class CpsSuspend(k: Function, tag: Any, handlerFun: Function)
data class CpsStackSafetyEffect(k: Function, tag: Any, retVal: Any)
fun cpsId(x) = x
fun cpsId2(k: Function, x) = k(x)
fun cpsSetCheckDepth() = CpsImpl.cpsSetCheckDepth()
fun cpsRaiseStack(k: Function, retVal) = CpsImpl.cpsRaiseStack(k, retVal)
fun runStackSafeCps(limit, f: () -> Any) = CpsImpl.runStackSafeCps(limit, f)
fun ss_cpsHandlerImpl(ss_k: Function, k: Function, tag, f: Function) = CpsImpl.ss_cpsHandlerImpl(ss_k, k, tag, f)
fun cpsHandlerImpl(k: Function, tag, f: Function) = CpsImpl.cpsHandlerImpl(k, tag, f)


module CpsImpl with

  fun handlerTrampoline(k: Function, tag, cur: Any): Any =
    while cur is
      CpsSuspend(resume, tag', handlerFun) do
        if tag' === tag then
          let handlerFunCont = (k1, v) =>
            handlerTrampoline(k1, tag, resume(v))
          set cur = handlerFun(cpsId, handlerFunCont)
        else return CpsSuspend(r => handlerTrampoline(k, tag, resume(r)), tag', handlerFun)
    k(cur)

  fun cpsHandlerImpl(k: Function, tag, f: Function) =
    handlerTrampoline(k, tag, f(cpsId))

  fun ss_handlerTrampoline(ss_k: Function, k: Function, tag, cur: Any): Any =
    if cpsSetCheckDepth() do
      return cpsRaiseStack(_ => cpsSetCheckDepth(); ss_handlerTrampoline(ss_k, k, tag, cur), ())
    fun loop(ss_k1, cur) =
      if cpsSetCheckDepth() do
        return cpsRaiseStack(_ => cpsSetCheckDepth(); loop(ss_k1, cur), ())
      if cur is
        CpsSuspend(resume, tag', handlerFun) then
          if tag' === tag then
            fun handlerFunCont(hfc_k, k1, v) =
              if cpsSetCheckDepth() do
                return cpsRaiseStack(_ => cpsSetCheckDepth(); handlerFunCont(hfc_k, k1, v), ())
              fun resumeCont(resume_r) =
                if cpsSetCheckDepth() do
                  return cpsRaiseStack(resumeCont, resume_r)
                ss_handlerTrampoline(hfc_k, k1, tag, resume_r)
              resume(resumeCont, v)
            fun cont(r) =
              if cpsSetCheckDepth() do
                return cpsRaiseStack(cont, r)
              loop(ss_k1, r)
            handlerFun(cont, cpsId2, handlerFunCont)
          else
            fun CpsSuspendCont1(resume_k, r) =
              if cpsSetCheckDepth() do
                return cpsRaiseStack(_ => cpsSetCheckDepth(); CpsSuspendCont1(resume_k, r), ())
              fun resumeCont1(resume_r) =
                if cpsSetCheckDepth() do
                  return cpsRaiseStack(resumeCont1, resume_r)
                ss_handlerTrampoline(resume_k, k, tag, resume_r)
              resume(resumeCont1, r)
            ss_k1 of CpsSuspend(CpsSuspendCont1, tag', handlerFun)
        else
          k(ss_k1, cur)
    loop(ss_k, cur)

  fun ss_cpsHandlerImpl(ss_k: Function, k: Function, tag, f: Function) =
    let res = f(res => ss_handlerTrampoline(ss_k, k, tag, res), cpsId2)
    res
  
  object StackDelayCpsHandler with
    fun delay(k, retVal) = new CpsStackSafetyEffect(k, stackHandler, retVal)
  
  fun cpsSetCheckDepth() =
    set stackDepth += 1
    stackDepth >= stackLimit && stackHandler !== null

  fun cpsRaiseStack(k: Function, retVal) =
    (stackHandler as StackDelayCpsHandler).delay(k, retVal)
  
  fun runStackSafeCps(limit, f: () -> Any) =
    set stackLimit = limit in...
    set stackDepth = 1 in...
    set stackHandler = StackDelayCpsHandler in...
    let result = f()
    while result is 
      CpsStackSafetyEffect(k, tag, retVal) do
        set stackDepth = 1 in...
        result = k(retVal)
    result


// js async
object AsyncEffectMarker

fun await(promise: Promise) =
  mkEffect(AsyncEffectMarker, (resume: Any -> Any) =>
    fun continuation(value) =
      let r = resume(value)
      if curEffect !== null do
        illegalEffect("in exported async function")
      r
    promise.then(continuation)
  )

fun toJsAsync(thunk: () -> Any) =
  let r = enterHandleBlock(AsyncEffectMarker, thunk)
  if curEffect !== null do
    illegalEffect("in exported async function")
  Promise.resolve(r)

// stack safety
mut val stackLimit = 0 // How deep the stack can go before heapifying the stack
mut val stackDepth = 0
mut val stackHandler = null
mut val stackResume = null

object StackDelayHandler with
  fun delay() = mkEffect of this, k =>
    set stackResume = k

fun checkDepth() =
  if stackDepth >= stackLimit && stackHandler !== null then
    // this is a tail call to effectful function
    (stackHandler as StackDelayHandler).delay()
  else
    ()

fun runStackSafe(limit: Int, f: () -> Any) =
  set stackLimit = limit in...
  set stackDepth = 1 in...
  set stackHandler = StackDelayHandler in...
  let result = internals.effectfulCallToInternal(() => enterHandleBlock(StackDelayHandler, f))
  if curEffect !== null do
    throw new Error("Effect crossed through stack safe boundary")
  while stackResume !== null do
    let saved = stackResume as Function
    set
      stackResume = null
      stackDepth = 1
      result = internals.effectfulCallToInternal(() => saved(()))
    if curEffect !== null do
      throw new Error("Effect crossed through stack safe boundary")
  result

class Int31(v: Int) with
  fun zext() = bitand(v, bitnot(shl(1, 31))) as Int
  fun sext() = bitor(v, shl(1, 31)) as Int

fun plus_impl(lhs, rhs) = if lhs is
  Int31 and rhs is Int31 then lhs + rhs
  else unreachable
