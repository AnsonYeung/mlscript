//│ >   Symbol(trigger_async_id_symbol): 27236
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: { x | "Expect end of input, but found y" }',
//│ >   Symbol(async_id_symbol): 27273,
//│ >   Symbol(trigger_async_id_symbol): 27271
//│ > }

// Empty parentheses with no expression
example of "()"
//│ > Promise {
//│ >   'Tokens: ┃(│)┃',
//│ >   Symbol(async_id_symbol): 27488,
//│ >   Symbol(trigger_async_id_symbol): 27486
//│ > }
//│ > Promise {
//│ >   'Parsed: Err(None, "Unexpected token )")',
//│ >   Symbol(async_id_symbol): 27834,
//│ >   Symbol(trigger_async_id_symbol): 27832
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: { "Unexpected token )" }',
//│ >   Symbol(async_id_symbol): 27867,
//│ >   Symbol(trigger_async_id_symbol): 27865
//│ > }

// Operator '*' at the end with no following operand
example of "3 + x *"
//│ > Promise {
//│ >   'Tokens: ┃3│␠│+│␠│x│␠│*┃',
//│ >   Symbol(async_id_symbol): 28347,
//│ >   Symbol(trigger_async_id_symbol): 28345
//│ > }
//│ > Promise {
//│ >   'Parsed: Add(Lit(3), Mul(Var("x"), Err(None, "Unexpected end of input")))',
//│ >   Symbol(async_id_symbol): 29079,
//│ >   Symbol(trigger_async_id_symbol): 29077
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: 3 + x * { "Unexpected end of input" }',
//│ >   Symbol(async_id_symbol): 29132,
//│ >   Symbol(trigger_async_id_symbol): 29130
//│ > }
