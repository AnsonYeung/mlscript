//│ >   Symbol(trigger_async_id_symbol): 23954
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: x + { "Unexpected token )" } + y',
//│ >   Symbol(async_id_symbol): 23997,
//│ >   Symbol(trigger_async_id_symbol): 23995
//│ > }

// Expression starting with an operator '*'
example of "* x + 5"
//│ > Promise {
//│ >   'Tokens: ┃*│␠│x│␠│+│␠│5┃',
//│ >   Symbol(async_id_symbol): 24473,
//│ >   Symbol(trigger_async_id_symbol): 24471
//│ > }
//│ > Promise {
//│ >   'Parsed: Add(Mul(Err(None, "Unexpected token *"), Var("x")), Lit(5))',
//│ >   Symbol(async_id_symbol): 25207,
//│ >   Symbol(trigger_async_id_symbol): 25205
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: { "Unexpected token *" } * x + 5',
//│ >   Symbol(async_id_symbol): 25260,
//│ >   Symbol(trigger_async_id_symbol): 25258
//│ > }

// Double operator '+' without an operand in between
example of "x + + 5"
//│ > Promise {
//│ >   'Tokens: ┃x│␠│+│␠│+│␠│5┃',
