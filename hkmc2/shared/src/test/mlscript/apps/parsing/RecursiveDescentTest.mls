// Unbalanced parentheses
example of "((x + y)"
//│ > Promise {
//│ >   'Tokens: ┃(│(│x│␠│+│␠│y│)┃',
//│ >   Symbol(async_id_symbol): 18201,
//│ >   Symbol(trigger_async_id_symbol): 18199
//│ > }
//│ > Promise {
//│ >   'Parsed: Err(Some(Add(Var("x"), Var("y"))), "Expected token ), but found end of input")',
//│ >   Symbol(async_id_symbol): 19005,
//│ >   Symbol(trigger_async_id_symbol): 19003
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: { x + y | "Expected token ), but found end of input" }',
//│ >   Symbol(async_id_symbol): 19044,
//│ >   Symbol(trigger_async_id_symbol): 19042
//│ > }

// Missing operand between '+' and '*'
example of "x + * y"
//│ > Promise {
//│ >   'Tokens: ┃x│␠│+│␠│*│␠│y┃',
//│ >   Symbol(async_id_symbol): 19519,
//│ >   Symbol(trigger_async_id_symbol): 19517
//│ > }
//│ > Promise {
//│ >   'Parsed: Add(Var("x"), Mul(Err(None, "Unexpected token *"), Var("y")))',
//│ >   Symbol(async_id_symbol): 20249,
//│ >   Symbol(trigger_async_id_symbol): 20247
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: x + { "Unexpected token *" } * y',
//│ >   Symbol(async_id_symbol): 20300,
//│ >   Symbol(trigger_async_id_symbol): 20298
//│ > }

// Another unbalanced parenthesis
example of "3 + (y"
//│ > Promise {
