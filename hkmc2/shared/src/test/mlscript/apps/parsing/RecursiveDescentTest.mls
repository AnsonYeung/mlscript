//│ >   Symbol(trigger_async_id_symbol): 6944
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: 1 + { 1 + 1 | "Expected token ), but found end of input" }',
//│ >   Symbol(async_id_symbol): 6995,
//│ >   Symbol(trigger_async_id_symbol): 6993
//│ > }

