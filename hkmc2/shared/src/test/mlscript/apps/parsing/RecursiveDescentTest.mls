//│ > }
//│ > Promise {
//│ >   'Parsed: Add(Add(Var("x"), Err(None, "Unexpected token +")), Lit(5))',
//│ >   Symbol(async_id_symbol): 26498,
//│ >   Symbol(trigger_async_id_symbol): 26496
//│ > }
//│ > Promise {
//│ >   'Pretty-printed: x + { "Unexpected token +" } + 5',
//│ >   Symbol(async_id_symbol): 26541,
//│ >   Symbol(trigger_async_id_symbol): 26539
//│ > }

// Missing operator between 'x' and 'y'
example of "x y"
//│ > Promise {
//│ >   'Tokens: ┃x│␠│y┃',
//│ >   Symbol(async_id_symbol): 26852,
//│ >   Symbol(trigger_async_id_symbol): 26850
//│ > }
//│ > Promise {
//│ >   'Parsed: Err(Some(Var("x")), "Expect end of input, but found y")',
