example of "1 + (1 + 1"
//│ > Promise {
//│ >   'Tokens: ┃1│␠│+│␠│(│1│␠│+│␠│1┃',
//│ >   Symbol(async_id_symbol): 5960,
//│ >   Symbol(trigger_async_id_symbol): 5958
//│ > }
//│ > Promise {
//│ >   'Parsed: Add(Lit(1), Err(Some(Add(Lit(1), Lit(1))), "Expected token ), but found end of input"))',
