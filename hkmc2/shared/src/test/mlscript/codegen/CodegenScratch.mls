:js

:global
// :sjs
// :sir

:sjs
module A with
  val x = 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A1;
//│ let staticInitAwaiter;
//│ (class A {
//│   static {
//│     A1 = this
//│   }
//│   static {
//│     staticInitAwaiter = (() => {
//│       this.x = 3;
//│     })();
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A"]; 
//│ });
//│ staticInitAwaiter
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:sjs
class A(val x)(val y)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A3;
//│ A3 = function A(x) {
//│   return (y) => {
//│     return globalThis.Object.freeze(new A.class(x)(y));
//│   }
//│ };
//│ (class A2 {
//│   static {
//│     A3.class = this
//│   }
//│   constructor(x) {
//│     return (y) => {
//│       this.x = x;
//│       this.y = y;
//│       return this;
//│     }
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A", ["x"]]; 
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let w = new A(1)
//│ w = fun

let h = w(2)
h.y
//│ = 2
//│ h = A(1)


let h2 = w(3)
h2.y
//│ = 3
//│ h2 = A(1)


h.y
//│ = 3
