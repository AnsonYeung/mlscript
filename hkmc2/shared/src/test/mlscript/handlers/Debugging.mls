class Debugger() with
  fun break(payload)

module Test with
  fun test(j)(using dbg: Debugger) =
    let i = 0
    let k = 2000
    if i == 0 do
      set i = dbg.break("whoops")
    j / i
  fun main()(using Debugger) =
    test(12) + test(34)
//│ > let Test1;try { globalThis.Object.freeze(class Test {   static {     Test1 = this   }   static *test(j) {     runtime.checkArgs("test", 1, true, arguments.length);     return (dbg) => {       let scrut, tmp5, tmp6;       scrut = runtime.checkCall(Predef.equals(0, 0));       if (scrut === true) {         tmp6 = runtime.checkCall(dbg.break("whoops"));         tmp5 = yield* tmp6;         return j / tmp5       }       return j / 0;     }   }   static *main() {     runtime.checkArgs("main", 0, true, arguments.length);     return (tmp5) => {       let tmp6, tmp7, tmp8;       tmp8 = runtime.checkCall(Test.test(12)(tmp5));       tmp6 = yield* tmp8;       tmp8 = runtime.checkCall(Test.test(34)(tmp5));       tmp7 = yield* tmp8;       return tmp6 + tmp7     }   }   toString() { return runtime.render(this); }   static [definitionMetadata] = ["class", "Test"]; });; undefined } catch (e) { console.log('\u200B' + (e.stack ?? e) + '\u200B'); }
