:re
fun lambda_test(f) =
  f()
  200
lambda_test(() =>
  raiseUnhandledEffect()
  100)
//│ ═══[RUNTIME ERROR] Error: Unhandled effect FatalEffect
//│ 	at tail position


import "../../mlscript-compile/Runtime.mls"

:silent
let res = Runtime._try(f)

res.reified.contTrace.next.getLocals
//│ = []

Runtime.debugEff(res.reified)
//│ > Debug EffectSig:
//│ > handler:  FatalEffect
//│ > handlerFun:  null
//│ > resumed:  false
//│ > <lastHandler is self>
//│ > FunctionContFrameImpl(pc=1, last) -> (null)
//│ > 

:expect Infinity
res.resumeWith(42)
//│ > 42
//│ = Infinity



abstract class Debugger() with
  fun break(payload)

module Test with
  fun test(j)(using dbg: Debugger) =
    let i = 0
    let k = 2000
    if i == 0 do
      set i = dbg.break("whoops")
    j / i
  fun main()(using dbg: Debugger) =
    test(12)(using dbg) + test(34)(using dbg)

// :rt
// :lot
let res = ({
  handle h = Debugger with
    fun break(payload)(resume) = resume
  using Debugger = h
  Runtime._try(() => Test.main()(using h))
} as Runtime.EffectHandle)
//│ res = EffectHandle(_)

:re
res.raise()
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$
//│ 	at Test.test (Debugging.mls:111:15)
//│ 	at Test.main (Debugging.mls:114:5)

set res = res.resumeWith(42)

:re
res.raise()
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$
//│ 	at Test.test (Debugging.mls:111:15)
//│ 	at Test.main (Debugging.mls:114:27)

:expect 0.33676533676533676
res.resumeWith(666)
//│ = 0.33676533676533676

// TODO: New resolution does not yet insert implicit arguments. Keep the
// original implicit calls alongside the explicit calls above.
module Test with
  fun test(j)(using dbg: Debugger) =
    let i = 0
    let k = 2000
    if i == 0 do
      set i = dbg.break("whoops")
    j / i
  fun main()(using Debugger) =
    test(12) + test(34)

