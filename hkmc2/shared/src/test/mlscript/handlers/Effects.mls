abstract class Effect with
  fun perform(arg: Str): Str


handle h = Effect with
  fun perform()(k) = "b"

:expect 42
handle h = Effect with
  fun perform()(k) = k(42)
h.perform()
//│ = 42

:expect "b"
handle h = Effect with
  fun perform(arg)(k) = "b"
h.perform("k")
//│ = "b"

:expect "k"
handle h = Effect with
  fun perform(arg)(k) = arg
h.perform("k")
//│ = "k"

:expect "k"
handle h = Effect with
  fun perform(arg)(k) = k(arg)
h.perform("k")
//│ = "k"

:expect "hi"
fun foo(e) = e.perform("hi")
handle h = Effect with
  fun perform(arg)(k) =
    print(arg)
    k(arg)
foo(h)
//│ > hi
//│ = "hi"

