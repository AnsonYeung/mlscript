:expect "54321"
:sjs
let result = ""
handle h = Effect with
  fun perform(arg)(k) =
    let v = k(arg)
    result = result + arg
    v
in
  h.perform("1")
  h.perform("2")
  h.perform("3")
  h.perform("4")
  h.perform("5")
result
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let result, h7, handleBlock$7, Handler$h$15;
//│ result = "";
//│ (class Handler$h$14 extends Effect1 {
//│   static {
//│     Handler$h$15 = this
//│   }
//│   constructor() {
//│     super();
//│   }
//│   *perform(arg) {
//│     let tmp, v, tmp1;
//│     tmp = yield this;
//│     tmp1 = runtime.safeCall(tmp(arg));
//│     v = yield * tmp1;
//│     result = result + arg;
//│     return v
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Handler$h$"];
//│ });
//│ h7 = new Handler$h$15();
//│ handleBlock$7 = (undefined, function *() {
//│   let tmp;
//│   runtime.safeCall(h7.perform("1"));
//│   runtime.safeCall(h7.perform("2"));
//│   runtime.safeCall(h7.perform("3"));
//│   runtime.safeCall(h7.perform("4"));
//│   tmp = runtime.safeCall(h7.perform("5"));
//│   return yield * tmp
//│ });
//│ runtime.enterHandleBlockGenerator(h7, handleBlock$7);
//│ return result
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:295)
//│ ═══[RUNTIME ERROR] Expected: '"54321"', got: '""'
//│ = ""
//│ result = ""


