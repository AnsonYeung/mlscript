:expect 123
fun foo(h) =
  h.perform()
  fun A() = 1
  let a = if true then
    module A with
      fun f() = 2
    A.f()
  else
    module A with
      fun f() = 3
    A.f()
  let b = if false then
    module A with
      fun f() = 2
    A.f()
  else
    module A with
      fun f() = 3
    A.f()
  A() * 100 + a * 10 + b
