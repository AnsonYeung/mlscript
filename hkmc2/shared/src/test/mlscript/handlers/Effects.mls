:js
:effectHandlers


abstract class Effect with
  fun perform(arg: Str): Str

handle h = Effect with
  fun perform()(k) = "b"

:expect 42
handle h = Effect with
  fun perform()(k) =
    k(42)
h.perform()
//│ = 42

:expect "b"
handle h = Effect with
  fun perform(arg)(k) = "b"
h.perform("k")
//│ = "b"

:expect "k"
handle h = Effect with
  fun perform(arg)(k) = arg
h.perform("k")
//│ = "k"

:expect "k"
handle h = Effect with
  fun perform(arg)(k) = k(arg)
h.perform("k")
//│ = "k"

:expect "hi"
fun foo(e) = e.perform("hi")
handle h = Effect with
  fun perform(arg)(k) =
    print(arg)
    k(arg)
foo(h)
//│ > hi
//│ = "hi"

fun foo(e) = e.perform("hi")

:expect "Hello World!"
handle h = Effect with
  fun perform(arg)(k) =
    print(arg)
    k(arg)
(() => h.perform("Hello") + " World!")()
//│ > Hello
//│ = "Hello World!"

:expect "54321"
:sjs
let result = ""
handle h = Effect with
  fun perform(arg)(k) =
    let v = k(arg)
    result = result + arg
    v
in
  h.perform("1")
  h.perform("2")
  h.perform("3")
  h.perform("4")
  h.perform("5")
result
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let result, h7, handleBlock$7, Handler$h$15, tmp7;
//│ result = "";
//│ (class Handler$h$14 extends Effect1 {
//│   static {
//│     Handler$h$15 = this
//│   }
//│   constructor() {
//│     super();
//│   }
//│   *perform(arg) {
//│     let Handler$h$perform, tmp8;
//│     Handler$h$perform = function *Handler$h$perform(k) {
//│       let v, tmp9;
//│       tmp9 = runtime.safeCall(k(arg));
//│       v = yield* tmp9;
//│       result = result + arg;
//│       return v
//│     };
//│     tmp8 = globalThis.Object.freeze([
//│       this,
//│       Handler$h$perform
//│     ]);
//│     return yield tmp8
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Handler$h$"];
//│ });
//│ h7 = new Handler$h$15();
//│ handleBlock$7 = (undefined, function *() {
//│   let tmp8;
//│   tmp8 = runtime.safeCall(h7.perform("1"));
//│   yield* tmp8;
//│   tmp8 = runtime.safeCall(h7.perform("2"));
//│   yield* tmp8;
//│   tmp8 = runtime.safeCall(h7.perform("3"));
//│   yield* tmp8;
//│   tmp8 = runtime.safeCall(h7.perform("4"));
//│   yield* tmp8;
//│   tmp8 = runtime.safeCall(h7.perform("5"));
//│   return yield* tmp8
//│ });
//│ tmp7 = runtime.enterHandleBlockGenerator(h7, handleBlock$7);
//│ runtime.handlerTopLevelCall(tmp7);
//│ return result
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "54321"
//│ result = "54321"


// Tuple matches will not be instrumented
:soir
:effectHandlers
fun f() = case [...x, y, z] then x
