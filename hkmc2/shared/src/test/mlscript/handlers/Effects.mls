//│     at Predef.equals (file:///home/attempt0/mlscript/head/hkmc2/shared/src/test/mlscript-compile/Predef.mjs:192:16)
//│     at Predef.nequals (file:///home/attempt0/mlscript/head/hkmc2/shared/src/test/mlscript-compile/Predef.mjs:246:18)
//│     at sum (REPL87:1:1295)
//│     at sum.next (<anonymous>)
//│     at sum (REPL87:1:1419)
//│     at sum.next (<anonymous>)
//│     at sum (REPL87:1:1419)
//│     at sum.next (<anonymous>)
//│     at sum (REPL87:1:1419)
//│     at sum.next (<anonymous>)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:295)
//│ ═══[RUNTIME ERROR] Expected: '450015000', got: 'undefined'

:re
fun sum(x) =
  if x != 0 then
    x + sum(x - 1)
  else 0
sum(10000)
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded

