:expect "Hello World!"
fun foo(h) =
  print("Entering foo")
  let result = h.perform("Hello")
  h.perform("?")
  print("Exiting foo")
  result
handle h = Effect with
  fun perform(arg)(k) =
    print("handler called")
    let result = k(arg)
    print("handler finished")
    result
print("mainbody start")
let result = foo(h) + " World!"
print("mainbody end")
result
//│ > mainbody start
//│ > Entering foo
//│ > Exiting foo
//│ > mainbody end
//│ > handler called
//│ > handler finished
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:297)
//│ ═══[RUNTIME ERROR] Expected: '"Hello World!"', got: '"?"'
//│ = "?"

:expect "Hello World!"
fun foo(h) =
  print("Entering foo")
  let result = h.perform("Hello")
  h.perform("Oops!")
  print("Exiting foo")
  result
fun bar(h) =
  print("Entering bar")
  let result = foo(h) + " World"
  print("Exiting bar")
  result
fun foobar(h) =
  print("Entering foobar")
  let result = bar(h) + "!"
  print("Exiting foobar")
  result
handle h = Effect with
  fun perform(arg)(k) =
    print("handler called")
    let result = k(arg)
    print("handler finished")
    result
print("mainbody start")
let result = foobar(h)
print("mainbody end")
result
//│ > mainbody start
//│ > Entering foobar
//│ > Entering bar
//│ > Entering foo
//│ > Exiting foo
//│ > Exiting bar
//│ > Exiting foobar
//│ > mainbody end
//│ > handler called
//│ > handler finished
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:297)
//│ ═══[RUNTIME ERROR] Expected: '"Hello World!"', got: '"Oops!"'
//│ = "Oops!"

// Float out definitions
handle h = Effect with
  fun perform(arg)(k) = arg
if true do
  fun f() = 3
  print(f())
//│ > 3

module A with
  data class Effect(x) with
    fun test() = x
    fun perform(arg)

handle h = A.Effect(3) with
  fun perform()(k) = 0
h.perform()
//│ = 0

fun f(perform) =
  handle h = Effect with
    fun perform(arg)(k) = arg
  perform()
f(() => 3)
//│ = 3

abstract class Cell with
  fun getVal(): Int
  fun setVal(Int): ()

let x = 0
handle h = Cell with
  fun getVal()(k) = k(x)
  fun setVal(value)(k) =
    x = value
    k(())
print(h.getVal())
h.setVal(1)
print(h.getVal())
//│ > ()
//│ > ()
//│ = 0
//│ x = 0


abstract class Eff with
  fun get(): Int

:expect 120
fun fact(e, factvalue) = 
  if factvalue != 0 then
    factvalue * fact(e, factvalue-1)
  else e.get()
handle h = Eff with
  fun get()(k) = k(1)
fact(h, 5)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:297)
//│ ═══[RUNTIME ERROR] Expected: '120', got: '1'
//│ = 1

abstract class StackDelay with
  fun raise(): ()

// stack safe recursion
:expect 5050
handle h = StackDelay with
  fun raise()(k) =
    // console.trace("Stack unwinded!")
    k(10)
fun sum(depth, x) =
  let new_depth = if depth > 70 then
    // console.trace("Too deep, heapifying the stack")
    h.raise()
  else
    depth + 1
  if x != 0 then
    x + sum(new_depth, x - 1)
  else 0
sum(0, 100)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:297)
//│ ═══[RUNTIME ERROR] Expected: '5050', got: '10'
//│ = 10

// stack safe recursion
:expect 450015000
handle h = StackDelay with
  fun raise()(k) =
    k(10)
fun sum(depth, x) =
  let new_depth = if depth > 1000 then h.raise() else depth + 1
  if x != 0 then
    x + sum(new_depth, x - 1)
  else 0
sum(0, 30000)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: mkQuery (JSBackendDiffMaker.scala:258)
//│ ═══[RUNTIME ERROR] ()
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:297)
//│ ═══[RUNTIME ERROR] Expected: '450015000', got: 'undefined'

:re
fun sum(x) =
  if x != 0 then
    x + sum(x - 1)
  else 0
sum(10000)
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'contTrace')

