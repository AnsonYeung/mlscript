:global
:js
:effectHandlers
:lift
:noInline
:patMatConsequentSharingThreshold 0

// Share the nested-pattern fallback so lowering introduces a label. Its normal exit
// must run the continuation after the label, just like the successful pattern
// match that exits via an explicit break.
data class Node(head, tail)
object Done

fun offset(x) = x + 1

fun choosePattern(xs) =
  let value = if xs is
    Done then 10
    Node([a, b], Done) then a + b
    else offset(30)
  value + 1

:expect 11
choosePattern(Done)
//│ = 11

:expect 6
choosePattern(Node([2, 3], Done))
//│ = 6

:expect 32
choosePattern(Node(0, Done))
//│ = 32

:expect 32
choosePattern(Node([2, 3], Node(0, Done)))
//│ = 32
