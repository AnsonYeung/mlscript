:global
:effectHandlers
:lift


fun breakFromNestedFunctionWithEffects() =
  do root:
    fun escape() = root.break(42)
    escape()
breakFromNestedFunctionWithEffects()
//│ = 42


fun breakFromNestedLambdaWithEffects() =
  do root:
    let escape = () => root.break(42)
    escape()
breakFromNestedLambdaWithEffects()
//│ = 42


fun breakFromNestedFunctionAndLambdaWithEffects() =
  do root:
    fun makeBreaker() = () => root.break(7)
    makeBreaker()()
breakFromNestedFunctionAndLambdaWithEffects()
//│ = 7


:sir
fun continueFromNestedFunctionWithEffects() =
  let i = 0 in do root:
    fun loop() =
      if i >= 3 do root.break(i)
      set i += 1
      root.continue
    loop()
