:js
:effectHandlers
:lift


// This acts as a function that may throw an effect
@annotations.noInline
fun f() = ()

// A constant function to block any potential optimization.
@annotations.noInline
fun always_true() = true


// Observe that no local variables will be saved, as they are not needed.
:sjs
:noOpt
fun g() =
  let a =
    if always_true() then
      f()
      1
    else
      2
  a
