// preserve tail calls
// MUST see "return hi(tmp1)" in the output
:stackSafe 6
:expect 0
:sjs
fun hi(n) =
  if n === 0 then 0
  else hi(n - 1)
hi(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let hi, tmp;
//│ hi = function *hi(n) {
//│   let scrut, tmp1, tmp2;
//│   scrut = n === 0;
//│   if (scrut === true) {
//│     return 0
//│   }
//│   tmp1 = n - 1;
//│   tmp2 = hi(tmp1);
//│   return yield* tmp2;
//│ };
//│ tmp = hi(0);
//│ return runtime.handlerTopLevelCall(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

