:stackSafe
:ssjs
fun shift_stack(n, f) =
  if n >= 0 then
    shift_stack(n - 1, f)
  else
    f()
fun handler_stack(n) =
  handle h = Eff with
    fun raise()(k) =
      shift_stack(N, k)
  h.raise()
  if n >= 0 do
    handler_stack(n - 1)
  "ok"
