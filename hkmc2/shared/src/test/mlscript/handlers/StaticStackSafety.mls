:js
:effectHandlers
:lift
:noTailRec
:sssr


:expect 5050
fun hi(n) =
  if n === 0 then 0
  else n + hi(n - 1)
hi(100)
//│ = 5050


// TODO: Call to g within f is recursive and non wrapper passed to g
:sir
fun f() =
  fun g() = f()
  id(g)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let g⁰, f⁰, g¹, f¹;
//│ do runtime⁰.resetEffects﹖();
//│ define g¹ as fun g²(handler) {
//│   let pc;
//│   match runtime⁰.resumePc﹖
//│     -1 =>
//│       set pc = 0;
//│       end
//│     else
//│       let saveOffset;
//│       set pc = runtime⁰.resumePc﹖;
//│       set runtime⁰.resumePc = -1;
//│       end
//│   loop main:
//│     match pc
//│       0 =>
//│         block brk0:
//│           set runtime⁰.resumeValue = handler.raise﹖();
//│           match runtime⁰.curEffect﹖
//│             null =>
//│               break brk0
//│             else
//│               return runtime⁰.unwind﹖(g², 1, null, null, null, 1, 1, handler, 0)
//│           end
//│         set pc = 1;
//│         end
//│     match pc
//│       1 =>
//│         do runtime⁰.resumeValue﹖;
//│         return f²(handler)
//│       else
//│         end
//│     end
//│   end
//│ };
//│ define g⁰ as fun g³() {
//│   return runtime⁰.runStaticStackSafe﹖(g²)
//│ };
//│ define f¹ as fun f²(handler) {
//│   let pc;
//│   match runtime⁰.resumePc﹖
//│     -1 =>
//│       set pc = 0;
//│       end
//│     else
//│       let saveOffset;
//│       set pc = runtime⁰.resumePc﹖;
//│       set runtime⁰.resumePc = -1;
//│       end
//│   loop main:
//│     match pc
//│       0 =>
//│         block brk0:
//│           set runtime⁰.resumeValue = handler.raise﹖();
//│           match runtime⁰.curEffect﹖
//│             null =>
//│               break brk0
//│             else
//│               return runtime⁰.unwind﹖(f², 1, null, null, null, 1, 1, handler, 0)
//│           end
//│         set pc = 1;
//│         end
//│     match pc
//│       1 =>
//│         do runtime⁰.resumeValue﹖;
//│         return Predef⁰.id⁰(g³)
//│       else
//│         end
//│     end
//│   end
//│ };
//│ define f⁰ as fun f³() { return runtime⁰.runStaticStackSafe﹖(f²) };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// g and h not instrumented
:sir
fun f() =
  fun g() = 1
  fun h() = g()
  if false do f()
  id(h)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let g⁴, h⁰, f⁴, f⁵;
//│ do runtime⁰.resetEffects﹖();
//│ define g⁴ as fun g⁵() {
//│   return 1
//│ };
//│ define h⁰ as fun h¹() {
//│   return g⁵()
//│ };
//│ define f⁵ as fun f⁶(handler) {
//│   let scrut, pc;
//│   match runtime⁰.resumePc﹖
//│     -1 =>
//│       set pc = 0;
//│       end
//│     else
//│       let saveOffset;
//│       set pc = runtime⁰.resumePc﹖;
//│       set runtime⁰.resumePc = -1;
//│       end
//│   loop main:
//│     match pc
//│       0 =>
//│         block brk0:
//│           set runtime⁰.resumeValue = handler.raise﹖();
//│           match runtime⁰.curEffect﹖
//│             null =>
//│               break brk0
//│             else
//│               return runtime⁰.unwind﹖(f⁶, 3, null, null, null, 1, 1, handler, 0)
//│           end
//│         set pc = 3;
//│         end
//│     match pc
//│       3 =>
//│         do runtime⁰.resumeValue﹖;
//│         set scrut = false;
//│         match scrut
//│           true =>
//│             set runtime⁰.resumeValue = f⁶(handler);
//│             match runtime⁰.curEffect﹖
//│               null =>
//│                 set pc = 2;
//│                 continue main
//│               else
//│                 return runtime⁰.unwind﹖(f⁶, 2, null, null, null, 1, 1, handler, 0)
//│             end
//│           else
//│             set pc = 1;
//│             continue main
//│         end
//│       2 =>
//│         begin
//│           do runtime⁰.resumeValue﹖;
//│           set pc = 1;
//│           end;
//│         match pc
//│           1 =>
//│             return Predef⁰.id⁰(h¹)
//│           else
//│             end
//│         end
//│       1 =>
//│         return Predef⁰.id⁰(h¹)
//│       else
//│         end
//│     end
//│   end
//│ };
//│ define f⁴ as fun f⁷() { return runtime⁰.runStaticStackSafe﹖(f⁶) };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


