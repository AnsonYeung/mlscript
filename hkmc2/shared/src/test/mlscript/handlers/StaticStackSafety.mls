:js
:effectHandlers
:lift
:noTailRec
:sssr


:expect 5050
:sjs
fun hi(n) =
  if n === 0 then 0
  else n + hi(n - 1)
hi(100)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let hi, hi1, tmp, n, inlinedVal;
//│ runtime.resetEffects();
//│ hi1 = function hi(handler, n1) {
//│   let scrut, tmp1, tmp2, pc;
//│   if (runtime.resumePc === -1) {
//│     pc = 0;
//│   } else {
//│     pc = runtime.resumePc;
//│     runtime.resumePc = -1;
//│   }
//│   switch (pc) {
//│     case 0:
//│       runtime.resumeValue = handler.raise();
//│       if (runtime.curEffect === null) {
//│         pc = 3;
//│       } else {
//│         return runtime.unwind(hi1, 3, null, null, null, 1, 2, handler, n1, 0)
//│       }
//│     case 3:
//│       runtime.resumeValue;
//│       scrut = n1 === 0;
//│       if (scrut === true) {
//│         return 0
//│       }
//│       tmp1 = n1 - 1;
//│       pc = 2;
//│     case 2:
//│       runtime.resumeValue = hi1(handler, tmp1);
//│       if (runtime.curEffect === null) {
//│         pc = 1;
//│       } else {
//│         return runtime.unwind(hi1, 1, null, null, null, 1, 2, handler, n1, 0)
//│       }
//│     case 1:
//│       tmp2 = runtime.resumeValue;
//│       return n1 + tmp2;
//│   }
//│ };
//│ hi = function hi(n1) {
//│   return runtime.runStaticStackSafe(hi1, n1)
//│ };
//│ n = 100;
//│ inlinedVal = runtime.runStaticStackSafe(hi1, n);
//│ tmp = inlinedVal;
//│ if (runtime.curEffect === null) { tmp } else { tmp = runtime.topLevelEffect(false); tmp }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5050


:sjs
class A with
  fun f() =
    fun g() = 0
    g()
