open annotations

abstract class ThreadEffect with
  val tasks = mut []
  fun start(thread: () -> ()): ()
  fun fork(thread: () -> ()): ()
  fun yld(): ()

class Lock(val locked) with
  fun lock(th: ThreadEffect) =
    while locked do
      th.yld()
    set locked = true
  fun unlock() =
    set locked = false

fun f(h, x) =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun mainn(h) =
  print("main start")
  h.fork(() => f(h, 0))
  h.fork(() => f(h, 1))
  h.fork(() => f(h, 2))
  print("main end")


// LIFO
handle h = ThreadEffect with
  fun fork(thread)(k) =
    @native this.tasks.unshift(thread)
    k(())
  fun yld()(k) =
    @native this.tasks.push(() => k(()))
    enterHandleBlock(this, () => (@native this.tasks.shift())())
  fun start(main)(k) =
    this.tasks.push(() => mainn(this))
    while this.tasks.length != 0 do
      enterHandleBlock(this, () => (@native this.tasks.shift())())
    k(())
in
  h.start(mainn)
