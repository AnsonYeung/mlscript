:js
:effectHandlers debug
:rewriteWhile


class ThreadEffect with
  // task queue
  val tasks = mut []
  fun drain() =
    while tasks.length != 0 do
      tasks.pop()()
  fun fork(thread: () -> ()): ()
  fun yld(): ()


fun f(h, x) = () =>
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun mainn(h) =
  print("main start")
  h.fork(f(h, 0))
  h.fork(f(h, 1))
  h.fork(f(h, 2))
  print("main end")


// LIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.push(thread)
    k()
    this.drain()
  fun yld()(k) =
    this.tasks.unshift(k)
    this.drain()
in
  mainn(h)
//│ > main start
//│ ═══[RUNTIME ERROR] TypeError: number 1 is not iterable (cannot read property Symbol(Symbol.iterator))


// FIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.unshift(thread)
    k()
    this.drain()
  fun yld()(k) =
    this.tasks.unshift(k)
    this.drain()
in
  mainn(h)
//│ > main start
//│ ═══[RUNTIME ERROR] TypeError: number 1 is not iterable (cannot read property Symbol(Symbol.iterator))


