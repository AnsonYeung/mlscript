:js
:effectHandlers debug
:rewriteWhile

class ThreadEffect with
  fun fork(thread: () -> ()): ()
  fun yld(): ()


fun f(h, x) = () =>
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun mainn(h) =
  print("mainn start")
  h.fork(f(h, 0))
  h.fork(f(h, 1))
  h.fork(f(h, 2))
  print("mainn end")


// task queue
let tasks = mut []
fun drain() =
  while tasks.length != 0 do
    tasks.pop()()
//│ tasks = []


// LIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.push(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  mainn(h)
//│ > mainn start
//│ ═══[RUNTIME ERROR] TypeError: number 1 is not iterable (cannot read property Symbol(Symbol.iterator))


// FIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.unshift(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  mainn(h)
//│ > mainn start
//│ ═══[RUNTIME ERROR] TypeError: number 2 is not iterable (cannot read property Symbol(Symbol.iterator))


