:stackSafe 6
set selfApp = f => f(f)

:expect 3628800
fact(10)
//│ = 3628800


:stackSafe 6
set selfApp = f => f(f)

fact(1000)
//│ = Infinity

// simplified version without lambdas for easier debugging
:stackSafe 6
fun mkrec(g) =
  fun a(self) =
    fun b(y) = selfApp(self)(y)
    g(b)
  selfApp(a)

open annotations

:stackSafe 6
import "../../mlscript-compile/Runtime.mls"
let fact =
  fun a(self) =
    fun b(x) =
      if x == 0 then 1 else
        let prev = self(x - 1)
        @native console.log("resumed:", x)
        x * prev
    b
  mkrec(a)
//│ fact = fun b

:expect 3628800
:stackSafe 6
fact(10)
//│ > resumed: 1
//│ > resumed: 2
//│ > resumed: 3
//│ > resumed: 4
//│ > resumed: 5
//│ > resumed: 6
//│ > resumed: 7
//│ > resumed: 8
//│ > resumed: 9
//│ > resumed: 10
//│ = 3628800
