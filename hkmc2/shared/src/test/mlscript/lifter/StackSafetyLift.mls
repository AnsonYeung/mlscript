:js
:lift
:noTailRec

// * FIXME: Why doesn't the following work when using Predef function `(==) equals`?

// sanity check
:expect 5050
fun sum(n) =
  if n === 0 then 0
  else
    n + sum(n - 1)
sum(100)
//│ = 5050

// preserve tail calls
// MUST see "return hi(tmp1)" in the output
:stackSafe
:effectHandlers
:expect 0
:sir
fun hi(n) =
  if n === 0 then 0
  else hi(n - 1)
hi(0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, ‹stack safe body›;
//│ do runtime⁰.resetEffects﹖();
//│ define hi⁰ as fun hi¹(n) {
//│   let curDepth;
//│   set curDepth = +⁰(runtime⁰.stackDepth﹖, 18);
//│   do runtime⁰.checkDepth﹖();
//│   match runtime⁰.curEffect﹖
//│     null =>
//│       let scrut, tmp1;
//│       set scrut = ===⁰(n, 0);
//│       match scrut
//│         true =>
//│           return 0
//│         else
//│           let res;
//│           set tmp1 = -⁰(n, 1);
//│           set runtime⁰.stackDepth﹖ = +⁰(curDepth, 1);
//│           return hi¹(tmp1)
//│       end
//│     else
//│       return runtime⁰.unwind﹖(hi¹, -1, "StackSafetyLift.mls:22:1", null, null, 1, 1, n, 0)
//│   end
//│ };
//│ define ‹stack safe body› as fun ‹stack safe body›⁰() {
//│   return hi¹(0)
//│ };
//│ set tmp = runtime⁰.runStackSafe﹖(10000, ‹stack safe body›⁰);
//│ match runtime⁰.curEffect﹖
//│   null =>
//│     return tmp
//│   else
//│     set tmp = runtime⁰.topLevelEffect﹖(false);
//│     return tmp
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:sir
:stackSafe
:effectHandlers
:expect 50005000
:ssjs
fun sum(n) =
  if n === 0 then 0
  else
    n + sum(n - 1)
sum(10000)
