:js
:lift
:noTailRec

// * FIXME: Why doesn't the following work when using Predef function `(==) equals`?

// sanity check
:expect 5050
fun sum(n) =
  if n === 0 then 0
  else
    n + sum(n - 1)
sum(100)
//│ = 5050

// preserve tail calls
// MUST see "return hi(tmp1)" in the output
:stackSafe 6
:effectHandlers
:expect 0
:sir
fun hi(n) =
  if n === 0 then 0
  else hi(n - 1)
hi(0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, ‹stack safe body›;
//│ @generator
//│ define hi⁰ as fun hi¹(n) {
//│   let scrut, tmp1, tmp2, curDepth;
//│   set tmp2 = runtime⁰.checkDepthGenerator﹖();
//│   set curDepth = +⁰(runtime⁰.GeneratorStackSafety﹖.stackDepth﹖, 1);
//│   do yield*⁰(tmp2);
//│   set scrut = ===⁰(n, 0);
//│   match scrut
//│     true =>
//│       return 0
//│     else
//│       set tmp1 = -⁰(n, 1);
//│       set runtime⁰.GeneratorStackSafety﹖.stackDepth﹖ = curDepth;
//│       set tmp2 = hi¹(tmp1);
//│       return yield*⁰(tmp2)
//│   end
//│ };
//│ define ‹stack safe body› as fun ‹stack safe body›⁰() {
//│   return hi¹(0)
//│ };
//│ set tmp = runtime⁰.runStackSafe﹖(6, ‹stack safe body›⁰);
//│ return tmp
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

