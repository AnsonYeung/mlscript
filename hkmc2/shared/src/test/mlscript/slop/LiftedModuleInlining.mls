:js


// Import under an alias so the worksheet cannot mask an escaped module receiver
// with a global binding having the same name as the compiled module's class.
import "../../mlscript-compile/ModuleReceiverCapture.mls" as Captures

// The lifted recursive worker captures Nested. Inlining read into it must also
// preserve read's reference to the enclosing ModuleReceiverCapture.
:expect 41
Captures.Nested.run(3)
//│ = 41

:expect 42
set Captures.value = 42
Captures.Nested.run(3)
//│ = 42

// The import alias is immutable, even though fields of the imported module may change.
:e
set Captures = Captures
//│ ╔══[COMPILATION ERROR] Cannot assign to module 'ModuleReceiverCapture'
//│ ║  l.+1: 	set Captures = Captures
//│ ║        	    ^^^^^^^^^^^^^^^^^^^
//│ ╟── Defined here:
//│ ║  in ../../mlscript-compile/ModuleReceiverCapture.mls
//│ ║  l.XX: 	module ModuleReceiverCapture with
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.XX: 	  mut val value: Int = 41
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.XX: 	  module Nested with
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ║  l.XX: 	    @inline
//│ ║        	^^^^^^^^^^^
//│ ║  l.XX: 	... (more lines omitted) ...
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An imported alias must also preserve the enclosing receiver when calling read directly.
:soir
:expect 42
Captures.Nested.read()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return ModuleReceiverCapture⁰.value⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42



// Use an alias so the worksheet does not provide an accidental global binding for Runtime.
import "../../mlscript-compile/Runtime.mls" as RuntimeImpl

// These compiled runtime helpers lift functions out of nested modules. Inlining a method
// of the captured nested module must preserve its references to the enclosing Runtime.
:expect 42
RuntimeImpl.CpsImpl.ss_handlerTrampoline(x => x, (k: Function, x) => k(x), "test", 42)
//│ = 42

// Exercise the lifted continuation used when an effect resumes.
:expect 42
RuntimeImpl.CpsImpl.ss_handlerTrampoline(x => x, (k: Function, x) => k(x), "test",
  RuntimeImpl.CpsSuspend((resume: Function, value) => resume(value + 1), "test",
    (k, handlerK, perform: Function) => perform(k, handlerK, 41)))
//│ = 42

// The shadow-stack trampoline has the same enclosing-receiver dependency on its error path.
:expect 42
RuntimeImpl.try_catch(
  () => RuntimeImpl.ShadowStackImpl.topLevelTrampoline(null, () => throw 42),
  err => err)
//│ = 42
